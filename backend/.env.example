# Copy to .env and adjust. Everything works out of the box for local dev.

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# Port 5433 because a Homebrew postgresql@16 may own 127.0.0.1:5432 on this machine.
DATABASE_URL=postgresql+asyncpg://caremesh:caremesh_dev_password@localhost:5433/caremesh

# Required outside dev (at least 32 bytes). Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-not-a-secret-never-use-outside-dev
JWT_ISSUER=caremesh
JWT_AUDIENCE=caremesh-api

# Behind a reverse proxy that sets X-Forwarded-For, turn this on so the
# login limiter buckets on the real client address. Off by default.
TRUST_PROXY_HEADERS=false
# When set, /metrics requires "Authorization: Bearer <token>".
# METRICS_TOKEN=

# Database pools: the request pool and a separate small pool for the audit
# and AI request logs (a log write must never wait on its own request).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
AUDIT_POOL_SIZE=2
AUDIT_MAX_OVERFLOW=3

# AI (ADR 0002). "fake" is free, deterministic, and clearly labeled
# SIMULATED everywhere. Real providers are the only thing that can cost
# money and stay off unless you set one here plus a key.
# To run against a real model: set LLM_PROVIDER=gemini and put a Gemini
# API key (free tier) in LLM_API_KEY, then prove the wiring with:
#   uv run python -m scripts.live_check
# LLM_MODEL defaults to gemini-flash-latest.
LLM_PROVIDER=fake
# LLM_API_KEY=
# LLM_MODEL=gemini-flash-latest
AI_TIMEOUT_SECONDS=20

# RAG embeddings (ADR 0006). local_lexical: free, instant, no downloads.
# fastembed: real semantic retrieval, local ONNX model, one time ~90MB
# download. After switching, re-embed: uv run python -m scripts.reingest
EMBEDDING_PROVIDER=local_lexical

# Rate limiting (Redis). Login attempts per client address and account;
# AI requests per user per minute.
REDIS_URL=redis://localhost:6379/0
LOGIN_ATTEMPTS_PER_MINUTE=5
AI_REQUESTS_PER_MINUTE=20
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
